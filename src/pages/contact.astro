---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { company } from '../data/site';

const title = `Contact | ${company.name}`;
const description =
  'Get in touch with Apex MEP Contract Solutions Inc. for MEP contract, procurement and project-support services in Hamilton and across Ontario, Canada.';
const addr = company.address;
---
<BaseLayout title={title} description={description} path="/contact/">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Contact</span>
      <h1>Let’s talk about your project.</h1>
      <p class="lead">
        Tell us what you’re working on and we’ll get back to you with the right
        support, from a single contract review to ongoing commercial management.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <!-- Details -->
      <aside class="contact-info">
        <h2>Get in touch</h2>
        <ul class="info-list">
          <li>
            <span class="info-ic"><Icon name="pin" /></span>
            <div>
              <strong>Registered office</strong>
              <p>{addr.street}<br />{addr.city}, {addr.region} {addr.postalCode}<br />{addr.country}</p>
            </div>
          </li>
          <li>
            <span class="info-ic"><Icon name="mail" /></span>
            <div>
              <strong>Email</strong>
              <p><a href={`mailto:${company.email}`}>{company.email}</a></p>
            </div>
          </li>
          {company.phone && (
            <li>
              <span class="info-ic"><Icon name="phone" /></span>
              <div>
                <strong>Phone</strong>
                <p><a href={`tel:${company.phone.replace(/[^+\d]/g, '')}`}>{company.phone}</a></p>
              </div>
            </li>
          )}
          <li>
            <span class="info-ic"><Icon name="clock" /></span>
            <div>
              <strong>Service area</strong>
              <p>{company.serviceArea}</p>
            </div>
          </li>
          {company.linkedin && (
            <li>
              <span class="info-ic"><Icon name="linkedin" /></span>
              <div>
                <strong>LinkedIn</strong>
                <p><a href={company.linkedin} rel="noopener">Connect with us</a></p>
              </div>
            </li>
          )}
        </ul>
        <div class="reg-badge">
          <Icon name="shield" />
          <span>Ontario Corp. No. {company.corpNumber} · Incorporated {company.incorporated}</span>
        </div>
      </aside>

      <!-- Form -->
      <div class="contact-form-wrap">
        <!--
          TODO: connect this form to a form service before going live.
          Easiest options (no server needed):
            • Formspree: set action="https://formspree.io/f/XXXXXXXX"
            • Web3Forms: add a hidden <input name="access_key" ...>
            • Netlify Forms: add `netlify` attribute to the <form>
          Until then, the "Email us directly" link below always works.
        -->
        <form
          class="contact-form"
          action="https://formspree.io/f/your-form-id"
          method="POST"
          id="contactForm"
        >
          <div class="field-row">
            <div class="field">
              <label for="name">Full name *</label>
              <input id="name" name="name" type="text" autocomplete="name" required />
            </div>
            <div class="field">
              <label for="company">Company</label>
              <input id="company" name="company" type="text" autocomplete="organization" />
            </div>
          </div>
          <div class="field-row">
            <div class="field">
              <label for="email">Email *</label>
              <input id="email" name="email" type="email" autocomplete="email" required />
            </div>
            <div class="field">
              <label for="phone">Phone</label>
              <input id="phone" name="phone" type="tel" autocomplete="tel" />
            </div>
          </div>
          <div class="field">
            <label for="service">How can we help?</label>
            <select id="service" name="service">
              <option value="">Select a service…</option>
              <option>MEP Contract Administration</option>
              <option>Construction Procurement</option>
              <option>Claims &amp; Variation Support</option>
              <option>Cost Control</option>
              <option>Project Coordination</option>
              <option>Tender &amp; Bid Support</option>
              <option>Not sure / general enquiry</option>
            </select>
          </div>
          <div class="field">
            <label for="message">Message *</label>
            <textarea id="message" name="message" rows="5" required></textarea>
          </div>
          <!-- honeypot (spam trap) -->
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
          <button type="submit" class="btn form-submit">Send message <Icon name="arrow" /></button>
          <p class="form-alt">
            Prefer email? <a href={`mailto:${company.email}`}>{company.email}</a>
          </p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background:
      radial-gradient(800px 400px at 90% -30%, rgba(43,108,176,0.1), transparent 55%),
      linear-gradient(180deg, #f7fafd, #fff);
    border-bottom: 1px solid var(--line);
    padding-top: clamp(34px, 4.5vw, 52px);
    padding-bottom: clamp(22px, 3vw, 34px);
  }
  .page-hero h1 { margin-block: 6px 16px; }
  .page-hero .lead { max-width: 56ch; }

  .contact-grid { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: 48px; align-items: start; }
  .contact-info h2 { color: var(--navy); margin-bottom: 24px; }
  .info-list { list-style: none; padding: 0; display: grid; gap: 22px; }
  .info-list li { display: flex; gap: 15px; align-items: flex-start; }
  .info-ic {
    flex-shrink: 0; width: 44px; height: 44px; border-radius: 11px; display: grid; place-items: center;
    background: linear-gradient(150deg, rgba(43,108,176,0.14), rgba(243,165,52,0.16)); color: var(--navy-600);
  }
  .info-ic :global(svg) { width: 21px; height: 21px; }
  .info-list strong { color: var(--navy); display: block; margin-bottom: 3px; }
  .info-list p { font-size: 0.97rem; }

  .reg-badge {
    display: flex; align-items: center; gap: 10px; margin-top: 30px; padding: 14px 18px;
    background: var(--bg-alt); border: 1px solid var(--line); border-radius: 12px;
    font-size: 0.85rem; color: var(--muted);
  }
  .reg-badge :global(svg) { width: 20px; height: 20px; color: var(--accent-600); flex-shrink: 0; }

  .contact-form {
    background: #fff; border: 1px solid var(--line); border-radius: var(--radius-lg);
    padding: clamp(24px, 3vw, 38px); box-shadow: var(--shadow-md);
  }
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .field { margin-bottom: 18px; display: flex; flex-direction: column; }
  .field label { font-size: 0.86rem; font-weight: 600; color: var(--navy); margin-bottom: 7px; }
  .field input,
  .field select,
  .field textarea {
    font-family: inherit; font-size: 1rem; color: var(--ink);
    padding: 12px 14px; border: 1.5px solid var(--line); border-radius: 10px; background: #fff;
    transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none; border-color: var(--blue); box-shadow: 0 0 0 3px rgba(43,108,176,0.12);
  }
  .field textarea { resize: vertical; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; }
  .form-submit { margin-top: 6px; }
  .form-submit :global(svg) { width: 18px; height: 18px; }
  .form-alt { margin-top: 16px; font-size: 0.92rem; color: var(--muted); }

  @media (max-width: 940px) {
    .contact-grid { grid-template-columns: 1fr; gap: 36px; }
  }
  @media (max-width: 520px) {
    .field-row { grid-template-columns: 1fr; gap: 0; }
  }
</style>
