---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { company } from '../data/site';

const title = `Contact | ${company.name}`;
const description =
  'Get in touch with Apex MEP Contract Solutions Inc. for MEP contract, procurement and project-support services in Hamilton and across Ontario, Canada.';
const addr = company.address;
---
<BaseLayout title={title} description={description} path="/contact/">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Contact</span>
      <h1>Let’s talk about your project.</h1>
      <p class="lead">
        Tell us what you’re working on and we’ll get back to you with the right
        support, from a single contract review to ongoing commercial management.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <!-- Details -->
      <aside class="contact-info">
        <h2>Get in touch</h2>
        <ul class="info-list">
          <li>
            <span class="info-ic"><Icon name="pin" /></span>
            <div>
              <strong>Registered office</strong>
              <p>{addr.street}<br />{addr.city}, {addr.region} {addr.postalCode}<br />{addr.country}</p>
            </div>
          </li>
          <li>
            <span class="info-ic"><Icon name="mail" /></span>
            <div>
              <strong>Email</strong>
              <p><a href={`mailto:${company.email}`}>{company.email}</a></p>
            </div>
          </li>
          {company.phone && (
            <li>
              <span class="info-ic"><Icon name="phone" /></span>
              <div>
                <strong>Phone</strong>
                <p><a href={`tel:${company.phone.replace(/[^+\d]/g, '')}`}>{company.phone}</a></p>
              </div>
            </li>
          )}
          <li>
            <span class="info-ic"><Icon name="clock" /></span>
            <div>
              <strong>Service area</strong>
              <p>{company.serviceArea}</p>
            </div>
          </li>
        </ul>
        <div class="reg-badge">
          <Icon name="shield" />
          <span>Ontario Corp. No. {company.corpNumber} · Incorporated {company.incorporated}</span>
        </div>
      </aside>

      <!-- Reach out directly -->
      <div class="contact-cta">
        <h2>Reach out directly</h2>
        <p class="contact-cta__lead">
          The quickest way to start is a short conversation. Send us a note or give
          us a call, and we’ll get back to you with the right support for your project.
        </p>
        <div class="reach-actions">
          <a class="reach-card" href={`mailto:${company.email}`}>
            <span class="reach-ic"><Icon name="mail" /></span>
            <span class="reach-text">
              <strong>Email us</strong>
              <span>{company.email}</span>
            </span>
            <Icon name="arrow" />
          </a>
          {company.phone && (
            <a class="reach-card" href={`tel:${company.phone.replace(/[^+\d]/g, '')}`}>
              <span class="reach-ic"><Icon name="phone" /></span>
              <span class="reach-text">
                <strong>Call us</strong>
                <span>{company.phone}</span>
              </span>
              <Icon name="arrow" />
            </a>
          )}
        </div>
        <p class="reach-note">
          We typically respond within one business day. Prefer to plan ahead? Include
          a short summary of your project and the support you’re looking for.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background:
      radial-gradient(800px 400px at 90% -30%, rgba(43,108,176,0.1), transparent 55%),
      linear-gradient(180deg, #f7fafd, #fff);
    border-bottom: 1px solid var(--line);
    padding-top: clamp(34px, 4.5vw, 52px);
    padding-bottom: clamp(22px, 3vw, 34px);
  }
  .page-hero h1 { margin-block: 6px 16px; }
  .page-hero .lead { max-width: 56ch; }

  .contact-grid { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: 48px; align-items: start; }
  .contact-info h2 { color: var(--navy); margin-bottom: 24px; }
  .info-list { list-style: none; padding: 0; display: grid; gap: 22px; }
  .info-list li { display: flex; gap: 15px; align-items: flex-start; }
  .info-ic {
    flex-shrink: 0; width: 44px; height: 44px; border-radius: 11px; display: grid; place-items: center;
    background: linear-gradient(150deg, rgba(43,108,176,0.14), rgba(243,165,52,0.16)); color: var(--navy-600);
  }
  .info-ic :global(svg) { width: 21px; height: 21px; }
  .info-list strong { color: var(--navy); display: block; margin-bottom: 3px; }
  .info-list p { font-size: 0.97rem; }

  .reg-badge {
    display: flex; align-items: center; gap: 10px; margin-top: 30px; padding: 14px 18px;
    background: var(--bg-alt); border: 1px solid var(--line); border-radius: 12px;
    font-size: 0.85rem; color: var(--muted);
  }
  .reg-badge :global(svg) { width: 20px; height: 20px; color: var(--accent-600); flex-shrink: 0; }

  .contact-cta {
    background: #fff; border: 1px solid var(--line); border-radius: var(--radius-lg);
    padding: clamp(26px, 3vw, 40px); box-shadow: var(--shadow-md);
  }
  .contact-cta h2 { color: var(--navy); margin-bottom: 12px; }
  .contact-cta__lead { color: var(--muted); max-width: 46ch; margin-bottom: 26px; }

  .reach-actions { display: grid; gap: 14px; }
  .reach-card {
    display: flex; align-items: center; gap: 16px; padding: 18px 20px;
    border: 1.5px solid var(--line); border-radius: 14px; background: var(--bg-alt);
    color: var(--navy); text-decoration: none;
    transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .reach-card:hover {
    border-color: var(--blue); box-shadow: 0 0 0 3px rgba(43,108,176,0.1);
    transform: translateY(-1px);
  }
  .reach-ic {
    flex-shrink: 0; width: 46px; height: 46px; border-radius: 12px; display: grid; place-items: center;
    background: linear-gradient(150deg, rgba(43,108,176,0.14), rgba(243,165,52,0.16)); color: var(--navy-600);
  }
  .reach-ic :global(svg) { width: 22px; height: 22px; }
  .reach-text { display: flex; flex-direction: column; flex: 1; min-width: 0; }
  .reach-text strong { font-size: 1rem; }
  .reach-text span { font-size: 0.94rem; color: var(--muted); overflow-wrap: anywhere; }
  .reach-card > :global(svg) { width: 18px; height: 18px; color: var(--accent-600); flex-shrink: 0; }
  .reach-note { margin-top: 22px; font-size: 0.9rem; color: var(--muted); }

  @media (max-width: 940px) {
    .contact-grid { grid-template-columns: 1fr; gap: 36px; }
  }
</style>
