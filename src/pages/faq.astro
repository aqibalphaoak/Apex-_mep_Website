---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import { company, faqs } from '../data/site';

const title = `FAQ | ${company.name}`;
const description =
  'Frequently asked questions about Apex MEP Contract Solutions Inc.: our services, scope, service area, pricing and how to get started.';

// FAQ structured data for rich results in search
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<BaseLayout title={title} description={description} path="/faq/">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">FAQ</span>
      <h1>Frequently asked questions</h1>
      <p class="lead">
        A few of the questions contractors ask us most. Don’t see yours?
        <a href="/contact/">Get in touch</a>. We’re happy to help.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container faq-wrap">
      {faqs.map((f, i) => (
        <details class="faq-item" open={i === 0}>
          <summary>
            <span>{f.q}</span>
            <span class="faq-icon" aria-hidden="true"></span>
          </summary>
          <div class="faq-answer"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
  </section>

  <CTA />

  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</BaseLayout>

<style>
  .page-hero {
    background:
      radial-gradient(800px 400px at 90% -30%, rgba(43,108,176,0.1), transparent 55%),
      linear-gradient(180deg, #f7fafd, #fff);
    border-bottom: 1px solid var(--line);
    padding-top: clamp(34px, 4.5vw, 52px);
    padding-bottom: clamp(22px, 3vw, 34px);
  }
  .page-hero h1 { margin-block: 6px 16px; }
  .page-hero .lead { max-width: 58ch; }

  .faq-wrap { max-width: 800px; margin-inline: auto; display: grid; gap: 14px; }
  .faq-item {
    border: 1px solid var(--line); border-radius: var(--radius);
    background: #fff; box-shadow: var(--shadow-sm); overflow: hidden;
  }
  .faq-item summary {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: 20px 24px; cursor: pointer; list-style: none;
    font-weight: 600; color: var(--navy); font-size: 1.06rem;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-icon {
    position: relative; flex-shrink: 0; width: 20px; height: 20px;
  }
  .faq-icon::before,
  .faq-icon::after {
    content: ''; position: absolute; background: var(--accent-600); border-radius: 2px;
    transition: transform 0.25s var(--ease), opacity 0.25s var(--ease);
  }
  .faq-icon::before { top: 9px; left: 0; width: 20px; height: 2px; }
  .faq-icon::after { top: 0; left: 9px; width: 2px; height: 20px; }
  .faq-item[open] .faq-icon::after { transform: scaleY(0); opacity: 0; }
  .faq-answer { padding: 0 24px 22px; }
  .faq-answer p { color: var(--body); }
  .faq-item[open] summary { border-bottom: 1px solid var(--line); }
  .faq-item[open] summary { padding-bottom: 18px; }
</style>
